+
+std::vector<std::string> requested_timing_granularities(const Request & req) {
+    std::vector<std::string> result;
+    for (const auto & value : req.get_file_values("timestamp_granularities[]")) {
+        if (std::find(result.begin(), result.end(), value.content) == result.end()) {
+            result.push_back(value.content);
+        }
+    }
+    if (result.empty()) {
+        result.push_back("segment");
+    }
+    return result;
