+    double eta_seconds = 0.0;
+};
+
+json contract_request_json(const std::shared_ptr<contract_request_state> & request) {
+    std::lock_guard<std::mutex> lock(request->mutex);
+    return {
+        {"object", "audio.request"},
+        {"schema_version", contract_schema_version},
+        {"request_id", request->request_id},
+        {"state", request->state},
+        {"phase", request->phase},
+        {"processed_audio_seconds", request->processed_audio_seconds},
+        {"total_audio_seconds", request->total_audio_seconds},
+        {"completed_work", request->processed_audio_seconds},
+        {"total_work", request->total_audio_seconds},
+        {"fraction_completed", request->fraction_completed},
+        {"eta_seconds", request->eta_seconds},
+        {"cancellation_requested", request->cancel_requested.load()},
+    };
+}
+
+void finish_contract_request(
+        const std::shared_ptr<contract_request_state> & request,
+        int response_status) {
+    std::lock_guard<std::mutex> lock(request->mutex);
+    if (request->cancel_requested.load()) {
+        request->state = "cancelled";
+        request->phase = "cancelled";
+    } else if (response_status >= 400) {
+        request->state = "failed";
+        request->phase = "failed";
+    } else {
+        request->state = "completed";
+        request->phase = "completed";
+        request->processed_audio_seconds = request->total_audio_seconds;
+        request->fraction_completed = 1.0;
+        request->eta_seconds = 0.0;
+    }
+}
+
+struct contract_inference_callbacks {
+    const Request * request = nullptr;
+    std::shared_ptr<contract_request_state> state;
+    std::function<bool(const std::string &)> emit;
+    std::chrono::steady_clock::time_point started_at;
+    double total_audio_seconds = 0.0;
+    double pass_start_fraction = 0.0;
+    double pass_fraction = 1.0;
+};
+
+void contract_progress_callback(
+        whisper_context *,
+        whisper_state *,
+        int progress,
+        void * user_data) {
+    auto * callbacks = static_cast<contract_inference_callbacks *>(user_data);
+    const double pass_fraction = std::clamp(progress / 100.0, 0.0, 1.0);
+    const double fraction = callbacks->pass_start_fraction + pass_fraction * callbacks->pass_fraction;
+    const double processed = callbacks->total_audio_seconds * fraction;
+    const double elapsed = elapsed_seconds(callbacks->started_at, std::chrono::steady_clock::now());
+    const double eta = fraction > 0.0 ? std::max(0.0, elapsed / fraction - elapsed) : 0.0;
+    json event = {
+        {"schema_version", contract_schema_version},
+        {"request_id", callbacks->state->request_id},
+        {"phase", "inference"},
+        {"processed_audio_seconds", processed},
+        {"total_audio_seconds", callbacks->total_audio_seconds},
+        {"fraction_completed", fraction},
+        {"eta_seconds", eta},
+    };
+    {
+        std::lock_guard<std::mutex> lock(callbacks->state->mutex);
+        callbacks->state->phase = "inference";
+        callbacks->state->processed_audio_seconds = processed;
+        callbacks->state->fraction_completed = fraction;
+        callbacks->state->eta_seconds = eta;
+    }
+    if (callbacks->emit && !callbacks->emit("event: progress\ndata: " + event.dump() + "\n\n")) {
+        callbacks->state->cancel_requested.store(true);
+    }
+}
+
+bool contract_abort_callback(void * user_data) {
+    auto * callbacks = static_cast<contract_inference_callbacks *>(user_data);
+    return (callbacks->state && callbacks->state->cancel_requested.load())
