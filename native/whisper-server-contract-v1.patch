+
+void set_contract_error(
+        Response & res,
+        int status,
+        const std::string & code,
+        const std::string & message,
+        const std::string & request_id = "") {
+    res.status = status;
+    json error = {
+        {"code", code},
+        {"message", message},
+        {"details", json::object()},
+    };
+    if (!request_id.empty()) {
+        error["request_id"] = request_id;
+    }
